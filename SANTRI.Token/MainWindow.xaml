<Window x:Class="SANTRI.Token.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SANTRI.Token" 
        Width="1024" Height="768" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Background>
        <ImageBrush ImageSource="/rsuwk_new.png" Stretch="UniformToFill" Opacity="0.5"/>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#99000000">
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Image Source="/logo.png" HorizontalAlignment="Left" Margin="30,10"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="RSU Wijayakusuma Kebumen" Foreground="Green" FontSize="45" FontWeight="Bold" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="White" BlurRadius="2" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="PanelUtama" Grid.Row="1" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="Silakan Pilih Jenis Antrean Anda" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Button x:Name="btnAmbilUmum"
                        FontSize="30" FontWeight="Bold" Foreground="White"
                        Width="600" Height="90" HorizontalAlignment="Center" Margin="0,0,0,15"
                        Click="btnAmbilUmum_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF4BFF26"/>
                            <GradientStop Color="#FF0C4001" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="A — UMUM" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
                </Button>

                <Button x:Name="btnAmbilJKN"
                        FontSize="30" FontWeight="Bold" Foreground="White"
                        Width="600" Height="90" HorizontalAlignment="Center" Margin="0,0,0,15"
                        Click="btnAmbilJKN_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF26A9FF"/>
                            <GradientStop Color="#FF013F66" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="B — ONLINE JKN (BPJS)" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
                </Button>

                <Button x:Name="btnAmbilHelp"
                        FontSize="30" FontWeight="Bold" Foreground="White"
                        Width="600" Height="90" HorizontalAlignment="Center"
                        Click="btnAmbilHelp_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FFFFB326"/>
                            <GradientStop Color="#FF804F01" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="C — HELPDESK" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
                </Button>

                <Border Background="#CC000000" CornerRadius="15" Padding="25,10" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Total Hari Ini:" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblTotalAntrean" Text="A 000 · B 000 · C 000" Foreground="Yellow" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <Grid x:Name="PanelHasil" Grid.Row="1" Background="Transparent" Visibility="Collapsed" Margin="150">
            <Border BorderBrush="DarkGreen" BorderThickness="5" CornerRadius="20" Background="White">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblJenisCetak" Text="Nomor Antrean Anda:" FontSize="40" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblNomorCetak" Text="A-000" FontSize="180" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="Mohon tunggu, tiket sedang dicetak..." FontSize="30" Foreground="Blue" HorizontalAlignment="Center" Margin="0,20"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="DarkGreen">
            <TextBlock x:Name="lblStatus" Text="Menghubungkan ke server..." Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="30,0"/>
        </Border>

        <Grid x:Name="PanelPassword" Grid.RowSpan="3" Background="#AA000000" Visibility="Collapsed">
            <Border Background="White" Width="300" Height="200" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Otorisasi Reset Antrean" FontSize="16" FontWeight="Bold" Foreground="DarkSlateGray" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" FontSize="20" Padding="5" Margin="0,15,0,20" HorizontalContentAlignment="Center"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Batal" Grid.Column="0" FontSize="14" FontWeight="Bold" Padding="0,8" Background="LightGray" Click="btnCancelReset_Click"/>
                        <Button Content="Konfirmasi" Grid.Column="2" FontSize="14" FontWeight="Bold" Padding="0,8" Background="DarkRed" Foreground="White" Click="btnConfirmReset_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>