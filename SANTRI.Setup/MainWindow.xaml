<Window x:Class="SANTRI.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SANTRI.Setup" Height="520" Width="550"
        WindowStartupLocation="CenterScreen" Background="MintCream">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Instalasi Sistem Antrean" FontSize="28" FontWeight="Bold" Foreground="DarkSlateGray"/>
            <TextBlock Text="Pilih komponen aplikasi yang ingin diinstal pada komputer ini:" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10,0">
            <CheckBox x:Name="chkServer" Content="SANTRI Server (Layar TV + Database Redis)" FontSize="16" Margin="0,10" FontWeight="SemiBold"/>
            <TextBlock Text="Pusat data antrean. Secara otomatis akan menginstal Redis Server secara *silent*." Foreground="DarkGray" Margin="25,-5,0,5" TextWrapping="Wrap"/>

            <CheckBox x:Name="chkClient" Content="SANTRI Client (Loket Pendaftaran)" FontSize="16" Margin="0,10" FontWeight="SemiBold"/>
            <TextBlock Text="Aplikasi untuk operator memanggil pasien." Foreground="DarkGray" Margin="25,-5,0,5"/>

            <CheckBox x:Name="chkToken" Content="SANTRI Token (Mesin Kiosk)" FontSize="16" Margin="0,10" FontWeight="SemiBold"/>
            <TextBlock Text="Aplikasi layar sentuh untuk pasien mengambil nomor antrean." Foreground="DarkGray" Margin="25,-5,0,5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10,10,10,25">
            <CheckBox x:Name="chkShortcut" Content="Buat shortcut aplikasi di Desktop" FontSize="14" IsChecked="True" Foreground="DarkSlateGray"/>
            <CheckBox x:Name="chkAutoRun" Content="Jalankan aplikasi setelah instalasi selesai" FontSize="14" Margin="0,8,0,0" IsChecked="False" Foreground="DarkSlateGray"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock x:Name="lblStatus" Text="Siap untuk memulai instalasi." FontSize="14" FontWeight="SemiBold" Foreground="DarkSlateGray" Margin="0,0,0,5"/>
            <ProgressBar x:Name="progressBar" Height="15" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <Button x:Name="btnInstall" Grid.Row="4" Content="MULAI INSTALASI" FontSize="16" FontWeight="Bold" Background="DarkGreen" Foreground="White" Height="45" Click="btnInstall_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>