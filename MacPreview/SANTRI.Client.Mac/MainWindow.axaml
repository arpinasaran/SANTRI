<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SANTRI.Client.Mac.MainWindow"
        Title="SANTRI.Client (Mac Preview)" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">
  <Window.Background>
    <ImageBrush Source="avares://SANTRI.Client.Mac/Assets/rsuwk_new.png" Stretch="UniformToFill" Opacity="0.5"/>
  </Window.Background>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="100"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#99000000">
      <Grid>
        <TextBlock Text="LOKET 1" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Name="lblLoketNo"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#CCFFFFFF" CornerRadius="15" Padding="50,0" Margin="20" HorizontalAlignment="Center">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Sedang Melayani:" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
        <TextBlock x:Name="lblCurrentCall" Text="000" FontSize="72" FontWeight="Bold" Foreground="DarkGreen" HorizontalAlignment="Center" Margin="0,5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
          <TextBlock Text="Sisa Antrean Menunggu: " FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
          <TextBlock x:Name="lblSisa" Text="0" FontSize="16" FontWeight="Bold" Foreground="Red"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="10,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="btnCall" Grid.Column="0" FontSize="16" FontWeight="Bold" Foreground="DarkSlateGray"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              CornerRadius="10" Click="btnCall_Click">
        <TextBlock Text="PANGGIL SELANJUTNYA" TextWrapping="Wrap" TextAlignment="Center"/>
        <Button.Background>
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#FF00FF1B"/>
            <GradientStop Color="#FF10841C" Offset="1"/>
          </LinearGradientBrush>
        </Button.Background>
      </Button>

      <Button x:Name="btnRecall" Grid.Column="2" FontSize="16" FontWeight="Bold" Foreground="DarkSlateGray"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              CornerRadius="10" Click="btnRecall_Click">
        <TextBlock Text="PANGGIL ULANG" TextWrapping="Wrap" TextAlignment="Center"/>
        <Button.Background>
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#FFE49C00"/>
            <GradientStop Color="#FF9E6C00" Offset="1"/>
          </LinearGradientBrush>
        </Button.Background>
      </Button>
    </Grid>

    <Border Grid.Row="3" Background="DarkSlateGray">
      <TextBlock x:Name="lblStatus" Text="Menghubungkan ke server..." Foreground="LightGreen" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
    </Border>
  </Grid>
</Window>
