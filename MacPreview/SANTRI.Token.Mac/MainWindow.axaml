<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SANTRI.Token.Mac.MainWindow"
        Title="SANTRI.Token (Mac Preview)"
        Width="820" Height="640" WindowStartupLocation="CenterScreen">

  <Window.Background>
    <ImageBrush Source="avares://SANTRI.Token.Mac/Assets/rsuwk_new.png" Stretch="UniformToFill" Opacity="0.5"/>
  </Window.Background>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="110"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="40"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#99000000">
      <Grid PointerPressed="Header_PointerPressed" Background="Transparent">
        <Image Source="avares://SANTRI.Token.Mac/Assets/logo.png" HorizontalAlignment="Left" Margin="30,10"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="RSU Wijayakusuma Kebumen" Foreground="Green" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="PanelUtama" Grid.Row="1" IsVisible="True">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock Text="Silakan Pilih Jenis Antrean Anda" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <Button x:Name="btnAmbilUmum"
                FontSize="26" FontWeight="Bold" Foreground="White"
                Width="480" Height="90" HorizontalAlignment="Center" Margin="0,0,0,15"
                CornerRadius="20" Click="btnAmbilUmum_Click"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Button.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Color="#FF4BFF26"/>
              <GradientStop Color="#FF0C4001" Offset="1"/>
            </LinearGradientBrush>
          </Button.Background>
          <TextBlock Text="A — UMUM" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
        </Button>

        <Button x:Name="btnAmbilJKN"
                FontSize="26" FontWeight="Bold" Foreground="White"
                Width="480" Height="90" HorizontalAlignment="Center" Margin="0,0,0,15"
                CornerRadius="20" Click="btnAmbilJKN_Click"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Button.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Color="#FF26A9FF"/>
              <GradientStop Color="#FF013F66" Offset="1"/>
            </LinearGradientBrush>
          </Button.Background>
          <TextBlock Text="B — ONLINE JKN (BPJS)" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
        </Button>

        <Button x:Name="btnAmbilHelp"
                FontSize="26" FontWeight="Bold" Foreground="White"
                Width="480" Height="90" HorizontalAlignment="Center"
                CornerRadius="20" Click="btnAmbilHelp_Click"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Button.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Color="#FFFFB326"/>
              <GradientStop Color="#FF804F01" Offset="1"/>
            </LinearGradientBrush>
          </Button.Background>
          <TextBlock Text="C — HELPDESK" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"/>
        </Button>

        <Border Background="#CC000000" CornerRadius="15" Padding="25,10" HorizontalAlignment="Center" Margin="0,30,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Total Hari Ini:" Foreground="White" FontSize="22" VerticalAlignment="Center"/>
            <TextBlock x:Name="lblTotalAntrean" Text="A 000 · B 000 · C 000" Foreground="Yellow" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </Grid>

    <Grid x:Name="PanelHasil" Grid.Row="1" Background="Transparent" IsVisible="False" Margin="100">
      <Border BorderBrush="DarkGreen" BorderThickness="5" CornerRadius="20" Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="lblJenisCetak" Text="Nomor Antrean Anda:" FontSize="28" Foreground="Gray" HorizontalAlignment="Center"/>
          <TextBlock x:Name="lblNomorCetak" Text="A-000" FontSize="110" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
          <TextBlock Text="Mohon tunggu, tiket sedang dicetak..." FontSize="20" Foreground="Blue" HorizontalAlignment="Center" Margin="0,10"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="DarkGreen">
      <TextBlock x:Name="lblStatus" Text="Menghubungkan ke server..." Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="30,0"/>
    </Border>

    <Grid x:Name="PanelPassword" Grid.RowSpan="3" Background="#AA000000" IsVisible="False">
      <Border Background="White" Width="300" Height="200" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Otorisasi Reset Antrean" FontSize="16" FontWeight="Bold" Foreground="DarkSlateGray" HorizontalAlignment="Center" Margin="0,0,0,5"/>
          <TextBox x:Name="txtPassword" PasswordChar="●" FontSize="20" Padding="5" Margin="0,15,0,20" HorizontalContentAlignment="Center"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Batal" Grid.Column="0" FontSize="14" FontWeight="Bold" Padding="0,8" Background="LightGray" HorizontalContentAlignment="Center" Click="btnCancelReset_Click"/>
            <Button Content="Konfirmasi" Grid.Column="2" FontSize="14" FontWeight="Bold" Padding="0,8" Background="DarkRed" Foreground="White" HorizontalContentAlignment="Center" Click="btnConfirmReset_Click"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
