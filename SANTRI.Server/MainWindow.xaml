<Window x:Class="SANTRI.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SANTRI.Server" WindowState="Maximized"
        Width="1920" Height="1080" WindowStartupLocation="CenterScreen" VerticalAlignment="Top" HorizontalAlignment="Center" 
        >
    <Window.Background>
        <ImageBrush Stretch="UniformToFill" Opacity="0.5">
            <ImageBrush.ImageSource>/rsuwk_new.png</ImageBrush.ImageSource>
        </ImageBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Background="#99000000" Grid.ColumnSpan="3" Visibility="Visible">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/logo.png" Margin="30,10" />
                <Grid VerticalAlignment="Center" >
                    <TextBlock Text="RSU Wijayakusuma Kebumen" Foreground="Green" FontSize="70" FontWeight="Bold" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="White" BlurRadius="2" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <Image Source="/logo.png" Margin="0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="3" Grid.RowSpan="3" Width="300" Opacity="0.5" Visibility="Collapsed"/>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0" Background="#E5097700">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="   Loket 1   " FontSize="40" Foreground="White" Padding="0" Margin="30,10,30,10">
                <StackPanel Margin="0,0">
                    <TextBlock x:Name="lblLoket1Count" Text="000" FontSize="100" FontWeight="Bold" Foreground="Orange" HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="   Loket 2   " FontSize="40" Foreground="White" Padding="0" Margin="30,0,30,10">
                <StackPanel Margin="0,0">
                    <TextBlock x:Name="lblLoket2Count" Text="000" FontSize="100" FontWeight="Bold" Foreground="Orange" HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="   Loket 3   " FontSize="40" Foreground="White" Padding="0" Margin="30,0,30,10">
                <StackPanel Margin="0,0">
                    <TextBlock x:Name="lblLoket3Count" Text="000" FontSize="100" FontWeight="Bold" Foreground="Orange" HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                <TextBlock Text="Sisa Antrean: " FontSize="30" VerticalAlignment="Center" Foreground="White"/>
                <TextBlock x:Name="lblLoketSisa" Text="0" FontSize="40" FontWeight="Bold" Margin="0,0,0,0" Foreground="White"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#B2C0C0C0" Margin="150,100">
            <MediaElement x:Name="videoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="VideoPlayer_MediaEnded" Visibility="Visible" Volume="0"/>
        </Grid>

        <Canvas Grid.Row="2" Grid.ColumnSpan="3" Background="DarkGreen" ClipToBounds="True">
            <TextBlock x:Name="lblMarque" Text="Selamat datang di RSU Wijayakusuma Kebumen. Jl. Gelatik 1 Panjer Kebumen 54312 Jawa Tengah Telp. (0287) 381954." Foreground="LightGray" FontSize="24" Canvas.Top="4" Canvas.Left="1200"/>
        </Canvas>
    </Grid>
</Window>