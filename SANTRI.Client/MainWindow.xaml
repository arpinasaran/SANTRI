<Window x:Class="SANTRI.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SANTRI.Client" Height="560" Width="500"
        WindowStartupLocation="CenterScreen" Topmost="True" >
    <Window.Background>
        <ImageBrush ImageSource="/rsuwk_new.png" Stretch="UniformToFill" Opacity="0.5"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#99000000">
            <Grid>
                <TextBlock Text="LOKET 1" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Name="lblLoketNo"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#CCFFFFFF" CornerRadius="15" Padding="50,0" Margin="20,10" HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Sedang Melayani:" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblCurrentCall" Text="---" FontSize="64" FontWeight="Bold" Foreground="DarkGreen" HorizontalAlignment="Center" Margin="0,5"/>
            </StackPanel>
        </Border>

        <!-- Satu baris per jenis antrean: label + sisa + tombol panggil -->
        <Grid Grid.Row="2" Margin="15,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="8"/>
                <RowDefinition/>
                <RowDefinition Height="8"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#CCFFFFFF" CornerRadius="10" Padding="15,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="A — Umum" FontSize="16" FontWeight="Bold" Foreground="DarkGreen" VerticalAlignment="Center" Width="170"/>
                        <TextBlock Text="Sisa: " FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSisaUmum" Text="0" FontSize="18" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="btnCallUmum" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="White" Click="btnCallUmum_Click">
                    <TextBlock Text="PANGGIL" TextAlignment="Center"/>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <Button.Background>
                        <SolidColorBrush Color="#FF10841C"/>
                    </Button.Background>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#CCFFFFFF" CornerRadius="10" Padding="15,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="B — Online JKN" FontSize="16" FontWeight="Bold" Foreground="DarkBlue" VerticalAlignment="Center" Width="170"/>
                        <TextBlock Text="Sisa: " FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSisaJKN" Text="0" FontSize="18" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="btnCallJKN" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="White" Click="btnCallJKN_Click">
                    <TextBlock Text="PANGGIL" TextAlignment="Center"/>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <Button.Background>
                        <SolidColorBrush Color="#FF01568C"/>
                    </Button.Background>
                </Button>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#CCFFFFFF" CornerRadius="10" Padding="15,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="C — Helpdesk" FontSize="16" FontWeight="Bold" Foreground="#FF804F01" VerticalAlignment="Center" Width="170"/>
                        <TextBlock Text="Sisa: " FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSisaHelp" Text="0" FontSize="18" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="btnCallHelp" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="White" Click="btnCallHelp_Click">
                    <TextBlock Text="PANGGIL" TextAlignment="Center"/>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <Button.Background>
                        <SolidColorBrush Color="#FF9E6C00"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Grid>

        <Button x:Name="btnRecall" Grid.Row="3" FontSize="16" FontWeight="Bold" Foreground="DarkSlateGray" Margin="15,8" Click="btnRecall_Click">
            <TextBlock Text="PANGGIL ULANG" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE49C00"/>
                    <GradientStop Color="#FF9E6C00" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Border Grid.Row="4" Background="DarkSlateGray">
            <TextBlock x:Name="lblStatus" Text="Menghubungkan ke server..." Foreground="LightGreen" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
        </Border>
    </Grid>
</Window>